                  "pm.test('Status is 200 or 201', function () { pm.expect([200,201]).to.include(pm.response.code); });",
                  "const json = pm.response.json(); pm.environment.set('studentId', json.id); pm.environment.set('studentCode','STU2001'); pm.environment.set('studentDob','2001-08-20');"
                ]
