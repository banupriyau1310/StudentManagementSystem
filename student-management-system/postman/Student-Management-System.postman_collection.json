                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json(); pm.environment.set('adminToken', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Student Verify",
          "request": {
            "method": "POST",
